# ========================================================
# Daily Outfit Studio — Backend Environment Variables
# ========================================================

# Server Port
PORT=5000
NODE_ENV=development

# Allowed Frontend Origins (comma separated or single URL)
FRONTEND_URL=http://localhost:3001

# PostgreSQL Database Connection
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?sslmode=require
# Examples:
# - Supabase / Neon: postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres?sslmode=require
# - Local Postgres:  postgresql://postgres:postgres@localhost:5432/rewear_radar
DATABASE_URL=
POSTGRES_URL=

# Supabase Configuration (Optional bridge for Auth verification & Storage)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI Stylist Configuration (Optional Cloud Gemini or Local Ollama)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OLLAMA_ENDPOINT=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
